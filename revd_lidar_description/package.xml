<?xml version="1.0"?>
<package format="3">
  <name>revd_lidar_description</name>
  <version>0.1.0</version>
  <description>URDF of the Rev D W11.25 mecanum base with a D500 LiDAR, ToF ring and IMU.</description>
  <maintainer email="safwan.shaikh@gmail.com">Safwan</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>joint_state_publisher_gui</exec_depend>
  <exec_depend>joint_state_publisher</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>rviz2</exec_depend>
  <exec_depend>xacro</exec_depend>

  <test_depend>ament_cmake_pytest</test_depend>
  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>
  <test_depend>liburdfdom-tools</test_depend>
  <test_depend>python3-numpy</test_depend>
  <test_depend>xacro</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
