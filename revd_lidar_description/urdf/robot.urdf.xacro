<?xml version="1.0"?>
<!-- Mecanum 01 Rev D W11.25 with an LDRobot D500 LiDAR. -->
<robot name="revd_lidar" xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:arg name="prefix" default=""/>
  <xacro:arg name="use_gazebo" default="false"/>
  <xacro:arg name="controllers_file" default=""/>

  <xacro:include filename="materials.xacro"/>
  <xacro:include filename="inertials.xacro"/>
  <xacro:include filename="properties.xacro"/>
  <xacro:include filename="macros/mecanum_wheels.xacro"/>
  <xacro:include filename="base.xacro"/>
  <xacro:include filename="tof.xacro"/>
  <xacro:include filename="lidar.xacro"/>
  <xacro:include filename="imu.xacro"/>
  <xacro:include filename="ros2_control.xacro"/>

  <xacro:mobile_base_assembly prefix="$(arg prefix)"/>
  <xacro:mobile_base_tof_array prefix="$(arg prefix)"/>
  <xacro:mobile_base_lidar prefix="$(arg prefix)"/>
  <xacro:mobile_base_imu prefix="$(arg prefix)"/>

  <xacro:mobile_base_ros2_control
    prefix="$(arg prefix)"
    use_gazebo="$(arg use_gazebo)"
    controllers_file="$(arg controllers_file)"/>
</robot>
