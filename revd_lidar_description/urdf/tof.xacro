<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  <!-- One VL53L7CX carrier, guarding one body face.

       The link origin is the optical aperture, not the centre of the board:
       rays leave from here, so this is the frame the zone grid is expressed
       in and the frame Gazebo is handed. Everything physical hangs inboard of
       it along -X, which is into the body, because the macro is always called
       with the yaw that points +X out through the face.

       The optically meaningful point is the one every downstream consumer
       needs, and burying it inside a mesh offset makes every later transform
       a guess.

       pitch tilts +X down so one zone row is level; see tof_pitch. -->
  <xacro:macro name="mobile_base_tof" params="prefix name x y z pitch yaw">
    <link name="${prefix}tof_${name}_link">
      <!-- The populated PCB, set back behind the module that stands on it. -->

      <visual>
        <origin
          xyz="${-tof_module_height - tof_pcb_thickness / 2.0}
               ${tof_board_offset_y} ${tof_board_offset_z}"
          rpy="0 0 0"/>
        <geometry>
          <box size="${tof_pcb_thickness} ${tof_board_width}
                     ${tof_board_length}"/>
        </geometry>
        <material name="electronics_green"/>
      </visual>
      <!-- The sensor package; its front face is the aperture. -->
      <visual>
        <origin xyz="${-tof_module_height / 2.0} 0 0" rpy="0 0 0"/>
        <geometry>
          <box size="${tof_module_height} ${tof_module_length}
                     ${tof_module_width}"/>
        </geometry>
        <material name="sensor_grey"/>
      </visual>
      <!-- One box over the whole carrier, board and module together. -->
      <collision>
        <origin xyz="${-tof_board_thickness / 2.0}
                     ${tof_board_offset_y} ${tof_board_offset_z}" rpy="0 0 0"/>
        <geometry>
          <box size="${tof_board_thickness} ${tof_board_width}
                     ${tof_board_length}"/>
        </geometry>
      </collision>
      <xacro:box_inertial mass="${tof_mass}"
                          x="${tof_board_thickness}" y="${tof_board_width}"
                          z="${tof_board_length}">
        <origin xyz="${-tof_board_thickness / 2.0}
                     ${tof_board_offset_y} ${tof_board_offset_z}" rpy="0 0 0"/>
      </xacro:box_inertial>
    </link>

    <joint name="${prefix}base_link_to_tof_${name}_link_joint" type="fixed">
      <parent link="${prefix}base_link"/>
      <child link="${prefix}tof_${name}_link"/>
      <origin xyz="${x} ${y} ${z}" rpy="0 ${pitch} ${yaw}"/>
    </joint>

    <!-- The kept rows' view (rows 4-6, tof_rows.yaml) is centred on the
         level row 5, not on the pitched sensor axis. Optical convention
         (+Z along the view), unpitched, for STVL's frustum clearing. -->
    <link name="${prefix}tof_${name}_rows_frame"/>
    <joint name="${prefix}base_link_to_tof_${name}_rows_frame_joint"
           type="fixed">
      <parent link="${prefix}base_link"/>
      <child link="${prefix}tof_${name}_rows_frame"/>
      <origin xyz="${x} ${y} ${z}" rpy="${-pi / 2.0} 0 ${yaw - pi / 2.0}"/>
    </joint>
  </xacro:macro>

  <!-- One sensor at the centre of each hull face. The four 60 degree fans
       cover 240 of 360 degrees; the D500 covers the 30 degree corner wedges
       above its scan plane. -->
  <xacro:macro name="mobile_base_tof_array" params="prefix">
    <xacro:mobile_base_tof prefix="${prefix}" name="front"
                           x="${tof_front_x}" y="0" z="${tof_z}"
                           pitch="${tof_pitch}" yaw="0"/>
    <xacro:mobile_base_tof prefix="${prefix}" name="rear"
                           x="${-tof_front_x}" y="0" z="${tof_z}"
                           pitch="${tof_pitch}" yaw="${pi}"/>
    <xacro:mobile_base_tof prefix="${prefix}" name="left"
                           x="0" y="${tof_side_y}" z="${tof_z}"
                           pitch="${tof_pitch}" yaw="${pi / 2.0}"/>
    <xacro:mobile_base_tof prefix="${prefix}" name="right"
                           x="0" y="${-tof_side_y}" z="${tof_z}"
                           pitch="${tof_pitch}" yaw="${-pi / 2.0}"/>
  </xacro:macro>
</robot>
