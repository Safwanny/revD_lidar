Panels:
  - Class: rviz_common/Displays
    Name: Displays
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Grid
      Cell Size: 0.05
      Plane Cell Count: 20
      Name: Grid
      Value: true
    - Class: rviz_default_plugins/Map
      Name: Map
      Topic:
        Durability Policy: Transient Local
        Value: /map
      Value: true
    - Alpha: 0.4
      Class: rviz_default_plugins/Map
      Color Scheme: costmap
      Name: Global costmap (nav:=true)
      Topic:
        Value: /global_costmap/costmap
      Value: true
    - Alpha: 0.6
      Class: rviz_default_plugins/Map
      Color Scheme: costmap
      Name: Local costmap (nav:=true)
      Topic:
        Value: /local_costmap/costmap
      Value: true
    - Class: rviz_default_plugins/Path
      Color: 60; 200; 255
      Name: Plan (nav:=true)
      Topic:
        Value: /plan
      Value: true
    - Class: rviz_default_plugins/RobotModel
      Description Source: Topic
      Description Topic:
        Value: /robot_description
      Name: Robot Model
      Value: true
    - Class: rviz_default_plugins/TF
      Marker Scale: 0.1
      Name: TF
      Show Arrows: false
      Show Axes: true
      Show Names: true
      Value: true
    - Alpha: 1
      Autocompute Intensity Bounds: true
      Class: rviz_default_plugins/LaserScan
      Color: 255; 60; 60
      Color Transformer: FlatColor
      Decay Time: 0
      Enabled: true
      Name: LiDAR scan
      Position Transformer: XYZ
      Selectable: true
      Size (Pixels): 3
      Size (m): 0.02
      Style: Points
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Best Effort
        Value: /scan
      Use Fixed Frame: true
      Value: true
    - Class: rviz_common/Group
      Displays:
      - Class: rviz_common/Group
        Displays:
        - Alpha: 1
          Autocompute Intensity Bounds: true
          Class: rviz_default_plugins/PointCloud2
          Color: 200; 210; 220
          Color Transformer: FlatColor
          Decay Time: 0
          Enabled: true
          Name: Front
          Position Transformer: XYZ
          Selectable: true
          Size (Pixels): 3
          Size (m): 0.004
          Style: Points
          Topic:
            Depth: 5
            Durability Policy: Volatile
            History Policy: Keep Last
            Reliability Policy: Best Effort
            Value: /tof/front/rows
          Use Fixed Frame: true
          Value: true
        - Alpha: 1
          Autocompute Intensity Bounds: true
          Class: rviz_default_plugins/PointCloud2
          Color: 200; 210; 220
          Color Transformer: FlatColor
          Decay Time: 0
          Enabled: true
          Name: Left
          Position Transformer: XYZ
          Selectable: true
          Size (Pixels): 3
          Size (m): 0.004
          Style: Points
          Topic:
            Depth: 5
            Durability Policy: Volatile
            History Policy: Keep Last
            Reliability Policy: Best Effort
            Value: /tof/left/rows
          Use Fixed Frame: true
          Value: true
        - Alpha: 1
          Autocompute Intensity Bounds: true
          Class: rviz_default_plugins/PointCloud2
          Color: 200; 210; 220
          Color Transformer: FlatColor
          Decay Time: 0
          Enabled: true
          Name: Rear
          Position Transformer: XYZ
          Selectable: true
          Size (Pixels): 3
          Size (m): 0.004
          Style: Points
          Topic:
            Depth: 5
            Durability Policy: Volatile
            History Policy: Keep Last
            Reliability Policy: Best Effort
            Value: /tof/rear/rows
          Use Fixed Frame: true
          Value: true
        - Alpha: 1
          Autocompute Intensity Bounds: true
          Class: rviz_default_plugins/PointCloud2
          Color: 200; 210; 220
          Color Transformer: FlatColor
          Decay Time: 0
          Enabled: true
          Name: Right
          Position Transformer: XYZ
          Selectable: true
          Size (Pixels): 3
          Size (m): 0.004
          Style: Points
          Topic:
            Depth: 5
            Durability Policy: Volatile
            History Policy: Keep Last
            Reliability Policy: Best Effort
            Value: /tof/right/rows
          Use Fixed Frame: true
          Value: true
        Enabled: true
        Name: Kept rows (4 sensors)
      - Class: rviz_default_plugins/MarkerArray
        Enabled: true
        Name: Rays
        Namespaces: {}
        Topic:
          Depth: 5
          Durability Policy: Volatile
          History Policy: Keep Last
          Reliability Policy: Reliable
          Value: /tof/rays
        Value: true
      Enabled: true
      Name: ToF ring
  Enabled: true
  Global Options:
    Background Color: 36; 38; 42
    Fixed Frame: odom
    Frame Rate: 30
  Name: root
  Tools:
    - Class: rviz_default_plugins/Interact
      Hide Inactive Objects: true
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
    - Class: rviz_default_plugins/FocusCamera
    - Class: rviz_default_plugins/SetInitialPose
      Topic:
        Value: /initialpose
    - Class: rviz_default_plugins/SetGoal
      Topic:
        Value: /goal_pose
  Value: true
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 3.0
      Focal Point:
        X: 0
        Y: 0
        Z: 0.05
      Name: Mobile Base View
      Near Clip Distance: 0.005
      Pitch: 0.8
      Target Frame: base_footprint
      Value: Orbit (rviz)
      Yaw: 0.75
    Saved: ~
Window Geometry:
  Height: 800
  Width: 1200
